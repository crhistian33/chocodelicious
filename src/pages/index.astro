---
import Base from "../layouts/Base.astro";
import {
  marca,
  productos,
  url,
  precio,
  enlaceWhatsApp,
  type Producto,
} from "../lib/datos";

const { portada, nosotros, contacto } = marca;
const whatsappGeneral = enlaceWhatsApp(contacto.whatsapp, contacto.mensaje);

const pedir = (nombre: string, valor: number) =>
  enlaceWhatsApp(
    contacto.whatsapp,
    `Hola, quiero pedir: ${nombre} (${precio(valor)})`,
  );

// ── Producto destacado para la portada ────────────────────────
// 1. Busca por coincidencia con portada.productoDestacado (en marca.json)
// 2. O busca un producto con "destacado": true (en productos.json)
const productoDestacado: Producto | undefined =
  (portada.productoDestacado
    ? productos.find(
        (p) =>
          p.nombre.toLowerCase().trim() ===
          portada.productoDestacado?.toLowerCase().trim(),
      )
    : undefined) ||
  productos.find((p) => p.destacado) ||
  undefined;

// Imagen final de la portada:
// Usa la del producto destacado, o la de portada.imagen, o la del primer producto
const imagenPortada =
  productoDestacado?.imagen ||
  portada.imagen ||
  productos[0]?.imagen ||
  marca.logo;
---

<Base
  titulo={`${marca.nombre} | ${marca.eslogan}`}
  descripcion={portada.subtitulo}
  favicon={marca.logo}
>
  <!-- ══ ENCABEZADO ══════════════════════════════════════════ -->
  <header class="encabezado">
    <div class="contenedor">
      <a class="marca" href="#inicio">
        <img src={url(marca.logo)} alt="" width="48" height="48" />
        <span class="name">{marca.nombre}</span>
      </a>

      <!-- Hamburguesa sin JS: el checkbox controla el menú por CSS -->
      <input
        type="checkbox"
        id="menu-toggle"
        class="menu-toggle"
        aria-hidden="true"
      />
      <label for="menu-toggle" class="menu-icono" aria-label="Abrir menú">
        <span></span>
        <span></span>
        <span></span>
      </label>

      <nav class="menu" aria-label="Navegación principal">
        <a href="#inicio">Inicio</a>
        <a href="#productos">Productos</a>
        <a href="#nosotros">Nosotros</a>
        <a href="#contacto">Contacto</a>
      </nav>
    </div>
  </header>

  <main id="inicio">
    <!-- ══ PORTADA ═════════════════════════════════════════════ -->
    <section class="portada">
      <div class="contenedor">
        <div class="portada-texto">
          {portada.badge && <span class="portada-badge">{portada.badge}</span>}
          <h1>{portada.titulo}</h1>
          <p>{portada.subtitulo}</p>

          <div class="portada-acciones">
            <a class="boton" href="#productos">
              {portada.textoBoton}
            </a>
            <a
              class="boton boton-borde"
              href={whatsappGeneral}
              target="_blank"
              rel="noopener noreferrer"
            >
              {portada.textoBotonSecundario || "Pedir por WhatsApp"}
            </a>
          </div>

          <!-- Micro-beneficios de confianza -->
          <div class="portada-puntos">
            <span>✨ 100% Artesanal</span>
            <span>💬 Atención rápida</span>
            <span>⭐ Calidad garantizada</span>
          </div>
        </div>

        <div class="portada-imagen">
          <!-- fetchpriority="high": la imagen principal se carga primero (mejor LCP) -->
          <img
            src={url(imagenPortada)}
            alt={productoDestacado ? productoDestacado.nombre : `Imagen de portada de ${marca.nombre}`}
            width="800"
            height="600"
            fetchpriority="high"
          />

          <!-- Tarjeta flotante interactiva con el producto destacado -->
          {productoDestacado && (
            <div class="tarjeta-destacado">
              <span class="tarjeta-destacado-icono" aria-hidden="true">⭐</span>
              <div class="tarjeta-destacado-info">
                <span class="tarjeta-destacado-etiqueta">
                  {productoDestacado.etiqueta || "Producto Estrella"}
                </span>
                <strong class="tarjeta-destacado-nombre">{productoDestacado.nombre}</strong>
                <span class="tarjeta-destacado-precio">{precio(productoDestacado.precio)}</span>
              </div>
              <a
                class="tarjeta-destacado-btn"
                href={pedir(productoDestacado.nombre, productoDestacado.precio)}
                target="_blank"
                rel="noopener noreferrer"
                title={`Pedir ${productoDestacado.nombre} por WhatsApp`}
              >
                Pedir este ➔
              </a>
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- ══ PRODUCTOS ═══════════════════════════════════════════ -->
    <section class="seccion" id="productos">
      <div class="contenedor">
        <div class="seccion-cabecera">
          <h2>Nuestros productos</h2>
        </div>
        <ul class="rejilla">
          {productos.map((p) => (
            <li class="producto">
              <div class="producto-foto">
                <img
                  src={url(p.imagen)}
                  alt={p.nombre}
                  width="800"
                  height="600"
                  loading="lazy"
                />
                {p.etiqueta && <span class="etiqueta">{p.etiqueta}</span>}
              </div>
              <div class="producto-cuerpo">
                <div class="producto-cabecera">
                  <h3>{p.nombre}</h3>
                  <span class="precio">{precio(p.precio)}</span>
                </div>
                <p class="producto-desc">{p.descripcion}</p>
                <a
                  class="boton boton-borde"
                  href={pedir(p.nombre, p.precio)}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Pedir por WhatsApp
                </a>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ══ NOSOTROS ════════════════════════════════════════════ -->
    <section class="seccion nosotros" id="nosotros">
      <div class="contenedor">
        <h2>{nosotros.titulo}</h2>
        <div class="nosotros-texto">
          <p>{nosotros.texto}</p>
          {nosotros.puntos.length > 0 && (
            <ul class="puntos">
              {nosotros.puntos.map((punto) => (
                <li>{punto}</li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </section>

    <!-- ══ CONTACTO ════════════════════════════════════════════ -->
    <section class="contacto" id="contacto">
      <div class="contenedor">
        <h2>Escríbenos y coordinamos tu pedido</h2>
        <p class="contacto-horario">{contacto.horario}</p>
        <a
          class="boton boton-claro"
          href={whatsappGeneral}
          target="_blank"
          rel="noopener noreferrer"
        >
          Escríbenos por WhatsApp
        </a>
        {(contacto.instagram || contacto.facebook) && (
          <p class="redes">
            {contacto.instagram && (
              <a
                href={contacto.instagram}
                target="_blank"
                rel="noopener noreferrer"
              >
                Instagram
              </a>
            )}
            {contacto.facebook && (
              <a
                href={contacto.facebook}
                target="_blank"
                rel="noopener noreferrer"
              >
                Facebook
              </a>
            )}
          </p>
        )}
      </div>
    </section>
  </main>

  <!-- ══ PIE ═════════════════════════════════════════════════ -->
  <footer class="pie">
    <div class="contenedor">
      <p>
        © {new Date().getFullYear()} {marca.nombre}. Proyecto escolar –
        Educación para el Trabajo.
      </p>
    </div>
  </footer>
</Base>
